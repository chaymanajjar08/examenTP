<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" ><LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
<TextView android:id="@+id/entete" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Fiche du contact" android:textSize="24sp"/>
<ImageView android:id="@+id/photo" android:layout_width="88dp" android:layout_height="88dp" android:layout_gravity="center_horizontal" android:scaleType="centerCrop" android:contentDescription="Photo du contact"/>
<EditText android:id="@+id/nom" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Nom" android:inputType="textPersonName" android:singleLine="true"/>
<EditText android:id="@+id/prenom" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Prénom" android:inputType="textPersonName" android:singleLine="true"/>
<EditText android:id="@+id/telephone" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Téléphone" android:inputType="phone" android:singleLine="true"/>
<EditText android:id="@+id/email" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Adresse e-mail" android:inputType="textEmailAddress" android:singleLine="true"/>
<EditText android:id="@+id/latitude" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Latitude" android:inputType="text" android:singleLine="true"/>
<EditText android:id="@+id/longitude" android:layout_width="match_parent" android:layout_height="wrap_content" android:hint="Longitude" android:inputType="text" android:singleLine="true"/>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/appeler" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Appeler" android:textAllCaps="false"/><Button android:id="@+id/envoyer" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Envoyer un e-mail" android:textAllCaps="false"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/galerie" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Galerie" android:textAllCaps="false"/><Button android:id="@+id/camera" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Caméra" android:textAllCaps="false"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/carte" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Voir sur la carte" android:textAllCaps="false"/></LinearLayout>
<LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"><Button android:id="@+id/annuler" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Annuler" android:textAllCaps="false"/><Button android:id="@+id/enregistrer" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Enregistrer" android:textAllCaps="false"/></LinearLayout>
<CheckBox android:id="@+id/favori" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Favori" /><Button android:id="@+id/supprimer" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Supprimer" android:textColor="#A82228" android:textAllCaps="false" android:visibility="gone" /></LinearLayout></ScrollView>

