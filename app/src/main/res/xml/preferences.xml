<PreferenceScreen xmlns:app="http://schemas.android.com/apk/res-auto">
    <PreferenceCategory app:title="Affichage">
        <ListPreference app:key="taille_police" app:title="Taille de police"
            app:entries="@array/tailles_libelles" app:entryValues="@array/tailles_valeurs"
            app:defaultValue="16" app:useSimpleSummaryProvider="true" />
        <ListPreference app:key="couleur_preferee" app:title="Couleur préférée"
            app:entries="@array/couleurs_libelles" app:entryValues="@array/couleurs_valeurs"
            app:defaultValue="@string/couleur_defaut" app:useSimpleSummaryProvider="true" />
    </PreferenceCategory>
    <PreferenceCategory app:title="Liste des contacts">
        <ListPreference app:key="ordre_tri" app:title="Ordre de tri" app:entries="@array/tri_libelles" app:entryValues="@array/tri_valeurs" app:defaultValue="favoris" app:useSimpleSummaryProvider="true" /><SwitchPreferenceCompat app:key="appel_depuis_liste" app:title="Activer l’appel depuis la liste"
            app:defaultValue="false" app:summaryOn="Oui" app:summaryOff="Non" />
    </PreferenceCategory>
</PreferenceScreen>


